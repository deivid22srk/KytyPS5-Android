+/* bionic host: glibc rtld data symbols (_rtld_global_ro, _rtld_global,
+ * __stack_chk_guard, ...) exist in no host library, so the dlsym() below
+ * returns NULL and guest GLOB_DAT relocations end up pointing at address 0.
+ * The very first IFUNC resolver in libc then segfaults reading
+ * GLRO(dl_x86_cpu_features) at _rtld_global_ro+0xb8.
+ * Back such symbols with zero-filled buffers of the declared size instead:
+ * zeroed cpu_features make the resolvers pick the baseline (SSE2)
+ * implementations, which is always safe. */
+static pthread_mutex_t s_datafallback_lock = PTHREAD_MUTEX_INITIALIZER;
+static khash_t(datafallback)* s_datafallback = NULL;
+static void* GetDataFallbackAndroid(const char* name, uint64_t size)
+{
+    pthread_mutex_lock(&s_datafallback_lock);
+    if(!s_datafallback)
+        s_datafallback = kh_init(datafallback);
+    khint_t k = kh_get(datafallback, s_datafallback, name);
+    void* p = (k!=kh_end(s_datafallback))?kh_value(s_datafallback, k):NULL;
+    if(!p) {
+        p = box_calloc(1, size?size:sizeof(void*));
+        int ret;
+        k = kh_put(datafallback, s_datafallback, name, &ret);
+        kh_value(s_datafallback, k) = p;
+    }
+    pthread_mutex_unlock(&s_datafallback_lock);
+    return p;
+}
+#endif
