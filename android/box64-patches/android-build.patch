diff --git a/src/wrapped/wrappedlibc.c b/src/wrapped/wrappedlibc.c
index f8ef724..c2b0a4b 100644
--- a/src/wrapped/wrappedlibc.c
+++ b/src/wrapped/wrappedlibc.c
@@ -5087,16 +5087,27 @@ static void* timed_exit_thread(void* a)
     _exit(box64_exit_code); // force exit, something is wrong
 }
 
+extern int box64lib_active;
+
 void startTimedExit()
 {
     static int started = 0;
     if(started)
         return;
+    #ifdef BOX64LIB
+    if(box64lib_active)
+        return; /* library mode: never _exit() the host process */
+    #endif
     started = 1;
     pthread_t exit_thread;
     pthread_create(&exit_thread, NULL, timed_exit_thread, NULL);
 }
 
+extern jmp_buf box64lib_exit_jmp;
+extern int box64lib_active;
+extern int box64lib_exit_code;
+extern pthread_t box64lib_thread;
+
 EXPORT void my_exit(x64emu_t* emu, int code)
 {
     if(emu->flags.quitonexit) {
@@ -5107,6 +5118,14 @@ EXPORT void my_exit(x64emu_t* emu, int code)
     }
     emu->quit = 1;
     box64_exit_code = code;
+    #ifdef BOX64LIB
+    /* library mode: return to the host instead of killing the process.
+     * Only safe when called from the thread that entered box64_main(). */
+    if(box64lib_active && pthread_equal(pthread_self(), box64lib_thread)) {
+        box64lib_exit_code = code;
+        longjmp(box64lib_exit_jmp, 1);
+    }
+    #endif
     endBox64();
     startTimedExit();
     exit(code);
