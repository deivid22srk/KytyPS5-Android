diff --git a/src/box64lib.c b/src/box64lib.c
new file mode 100644
index 0000000..3b09293
--- /dev/null
+++ b/src/box64lib.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: MIT
+/* box64 library mode — in-process x86_64 emulation for Android hosts.
+ *
+ * Instead of exec()-ing the box64 binary (which wipes the address space and
+ * invalidates host pointers such as ANativeWindow*), an Android host app
+ * dlopen()s libbox64.so and calls box64_main() on a dedicated thread.
+ * The emulated program then runs inside the host process.
+ *
+ * The exit path is bridged back to the caller: when the guest calls exit(),
+ * my_exit() (wrappedlibc.c) longjmp()s back to box64_main's frame when
+ * library mode is active, so the host survives and can report the exit
+ * code. See the KytyPS5 Android port (android/ in the KytyPS5-Android
+ * repository) for the host side.
+ */
+
+#include "core.h"
+
+#include <pthread.h>
+#include <setjmp.h>
+
+/* exported for my_exit() in wrappedlibc.c (same shared object) */
+jmp_buf box64lib_exit_jmp;
+int box64lib_active = 0;
+int box64lib_exit_code = 0;
+pthread_t box64lib_thread;
+
+__attribute__((visibility("default")))
+int box64_main(int argc, const char **argv, char **env)
+{
+    x64emu_t* emu = NULL;
+    elfheader_t* elf_header = NULL;
+
+    box64lib_thread = pthread_self();
+    box64lib_active = 1;
+
+    if (initialize(argc, argv, env, &emu, &elf_header, 1)) {
+        box64lib_active = 0;
+        return -1;
+    }
+
+    int code = setjmp(box64lib_exit_jmp);
+    if (code == 0) {
+        /* normal path: run the emulated program */
+        code = emulate(emu, elf_header);
+        box64lib_active = 0;
+        return code;
+    }
+
+    /* exit() was called by the guest (library-mode longjmp) */
+    box64lib_active = 0;
+    return box64lib_exit_code;
+}
