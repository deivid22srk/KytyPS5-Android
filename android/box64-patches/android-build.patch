-DATA(_rtld_global, sizeof(void*))
-DATA(_rtld_global_ro, sizeof(void*))
+/* Real x86_64 glibc sizes (struct rtld_global / rtld_global_ro of a
+ * ld-linux-x86-64.so.2): IFUNC resolvers read cpu_features at offsets up
+ * to ~0x400, so the old sizeof(void*) declarations overran any backing
+ * buffer and broke COPY relocations. Match the ld.so we ship in rootfs. */
+DATA(_rtld_global, 2888)
+DATA(_rtld_global_ro, 952)
 #endif
